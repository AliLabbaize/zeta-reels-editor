# Required: Gemini (transcription, planning, vision verification, source search)
GEMINI_API_KEY=

# Optional: Cohere second-opinion Arabic ASR (cohere-transcribe-arabic-07-2026)
COHERE_API_KEY=

# Optional: search backend for source resolution when Gemini grounding is off
# ZETA_SEARCH_API_KEY=

# Optional: `zeta publish` (docs/PUBLISH_SPEC.md)
# TikTok (developers.tiktok.com app, Login Kit + Content Posting API)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Meta app (developers.facebook.com, development mode) for Facebook + Instagram
# META_APP_ID=
# META_APP_SECRET=
